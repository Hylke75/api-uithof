# Kopieer naar .env.local (lokaal) en zet dezelfde variabelen in Vercel.
# Nooit echte waarden committen.

# --- Sync-gedrag ---
# true = proefmodus: facturen worden opgehaald, gemapt en gelogd, maar NIET in CASH geboekt.
# Pas op false zetten na akkoord op de parallel-run.
SYNC_DRY_RUN=true
# Eerste factuurdatum die meegenomen wordt bij de allereerste run (YYYY-MM-DD).
SYNC_START_DATE=2026-01-01

# --- Beveiliging ---
# Vercel stuurt dit mee als "Authorization: Bearer <CRON_SECRET>" bij cron-aanroepen.
CRON_SECRET=
# Login voor de beheerpagina (HTTP Basic Auth).
ADMIN_USER=
ADMIN_PASSWORD=

# --- Supabase ---
SUPABASE_URL=
# Service role key: alleen server-side gebruiken.
SUPABASE_SERVICE_ROLE_KEY=

# --- Smart Event Manager ---
# Productie De Uithof: https://deuithof.smarteventmanager.com
# Testomgeving:        https://apidemo.smarteventmanager.com
SEM_BASE_URL=https://apidemo.smarteventmanager.com
# Wordt meegestuurd als header "ApiKey". Elke omgeving heeft een eigen key.
SEM_API_KEY=

# --- CASH (REST API 4.0) ---
CASH_BASE_URL=https://www.cashweb.nl/api/4.0
# CashWeb > Gebruikersoverzicht > API-gebruiker > tab Api > kopieer-icoon (NIET op Genereer klikken).
CASH_API_KEY=
# Administratiecode (4 tekens), controleer met: npm run cash:verken
CASH_ADMINISTRATIE=demo
# Verkoopdagboek en debiteurenrekening in CASH (aanleveren door de boekhouding).
CASH_DAGBOEK=
CASH_GB_DEBITEUREN=
