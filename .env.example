# Kopieer naar .env.local (lokaal) en zet dezelfde variabelen in Vercel.
# Nooit echte waarden committen. Een wijziging in Vercel werkt pas na een nieuwe deployment.

# --- Sync-gedrag ---
# true = proefmodus: facturen worden opgehaald, omgezet en gelogd, maar NIET in CASH geboekt.
SYNC_DRY_RUN=true
# Vroegste factuurdatum en vroegste wijzigingsdatum van batches (YYYY-MM-DD). Moet op of vóór de
# datum van het startfactuurnummer liggen; het startfactuurnummer is de echte grens.
SYNC_START_DATE=2026-01-01
# Optioneel: eerste factuurnummer dat de koppeling boekt. Gaat voor de instelling
# start_factuurnummer in de database (op dit moment 823498).
# SYNC_START_FACTUUR=

# --- Beveiliging ---
# Vercel stuurt dit mee als "Authorization: Bearer <CRON_SECRET>" bij cron-aanroepen (min. 16 tekens).
CRON_SECRET=
# Login voor de beheerpagina (HTTP Basic Auth).
ADMIN_USER=
ADMIN_PASSWORD=

# --- Mails (Resend) ---
# API-sleutel met verzendrechten voor linkandlead.nl. Ontvanger staat in instelling melding_aan.
RESEND_API_KEY=

# --- Supabase ---
SUPABASE_URL=
# Service role key: alleen server-side gebruiken.
SUPABASE_SERVICE_ROLE_KEY=

# --- Smart Event Manager ---
SEM_BASE_URL=https://deuithof.smarteventmanager.com
# Wordt meegestuurd als header "ApiKey".
SEM_API_KEY=

# --- CASH (REST API 4.0) ---
CASH_BASE_URL=https://www.cashweb.nl/api/4.0
# CashWeb > Gebruikersoverzicht > API-gebruiker > tab Api > kopieer-icoon (NIET op Genereer klikken).
CASH_API_KEY=
# Administratiecode: "demo" (test) of de productieadministratie (spo1).
CASH_ADMINISTRATIE=demo
# Veiligheidsslot: echt boeken buiten "demo" kan alleen als deze waarde gelijk is aan
# CASH_ADMINISTRATIE (beide spo1).
# CASH_LIVE_ADMINISTRATIE=
# Optioneel; leeg = de instellingen cash_dagboek (VERKS) en cash_gb_debiteuren (1300) in de database.
CASH_DAGBOEK=
CASH_GB_DEBITEUREN=
